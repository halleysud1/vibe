"""Bot Telegram in modalità polling per {{ identity.name }} — con streaming live.

Riceve messaggi da Telegram via getUpdates (polling) e li inoltra all'AgentOS
HTTP API in **streaming** (POST /teams/{team_id}/runs con stream=true). Mentre il
loop gira, aggancia gli eventi SSE reali (ToolCallStarted/Completed, RunContent,
RunCompleted) e li proietta su UN messaggio di stato editato in-place: l'utente
*vede cosa sta facendo l'agente sotto* invece di fissare uno spinner.

Formato SSE di AgentOS (un evento = blocco separato da riga vuota):
    event: <EventName>
    data: {...json con campi 'content', 'tool', ...}

Vantaggio: non richiede URL pubblico (no ngrok/cloudflared). Funziona da localhost.

Usage:
    # 1. AgentOS server attivo (es. python -m agent.main)
    # 2. In altro terminale:
    python -m agent.interfaces.telegram_polling

Env richiesto:
    TELEGRAM_BOT_TOKEN     (obbligatorio)
    AGENTOS_HOST           (default: localhost)
    AGENTOS_PORT           (default: 7777)
    TELEGRAM_TEAM_ID       (default: derivato da identity.name del manifesto)
    TELEGRAM_ALLOWED_USERS (opzionale, comma-separated user_id Telegram)
"""

from __future__ import annotations
import json
import os
import sys
import time
import logging

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")

import requests
import telebot
from dotenv import load_dotenv

load_dotenv()

logging.basicConfig(level=logging.INFO, format="[%(asctime)s] %(message)s")
log = logging.getLogger("telegram_polling")

TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
HOST = os.getenv("AGENTOS_HOST", "localhost")
PORT = os.getenv("AGENTOS_PORT", "7777")
AGENTOS_URL = os.getenv("AGENTOS_URL", f"http://{HOST}:{PORT}")
TEAM_ID = os.getenv("TELEGRAM_TEAM_ID", "{{ identity.name | lower | replace(' ', '-') }}")
ALLOWED_USERS = {
    int(x) for x in os.getenv("TELEGRAM_ALLOWED_USERS", "").split(",")
    if x.strip().isdigit()
}
EDIT_THROTTLE = 1.2  # s minimi tra due edit del messaggio di stato (rate limit Telegram)

if not TOKEN:
    sys.exit("ERRORE: TELEGRAM_BOT_TOKEN non settato in .env")


def is_allowed(user_id: int) -> bool:
    """Se ALLOWED_USERS è vuoto, accetta tutti. Altrimenti solo whitelist."""
    return not ALLOWED_USERS or user_id in ALLOWED_USERS


def stream_agentos(message: str, session_id: str, timeout: int = 300):
    """Generator: POST .../runs con stream=true, yielda (event_name, data_dict).

    In caso di errore di trasporto yielda ('__error__', {'content': msg}).
    """
    try:
        resp = requests.post(
            f"{AGENTOS_URL}/teams/{TEAM_ID}/runs",
            files={
                "message": (None, message),
                "stream": (None, "true"),
                "session_id": (None, session_id),
            },
            stream=True,
            timeout=timeout,
        )
    except requests.RequestException as e:
        yield "__error__", {"content": f"AgentOS irraggiungibile: {e}"}
        return
    if resp.status_code != 200:
        yield "__error__", {"content": f"AgentOS HTTP {resp.status_code}: {resp.text[:300]}"}
        return

    event_name = None
    for raw in resp.iter_lines(decode_unicode=True):
        if not raw:
            event_name = None  # riga vuota = fine blocco evento SSE
            continue
        line = raw.strip()
        if line.startswith("event:"):
            event_name = line[len("event:"):].strip()
        elif line.startswith("data:"):
            payload = line[len("data:"):].strip()
            try:
                data = json.loads(payload)
            except ValueError:
                continue
            yield (event_name or data.get("event") or "message"), data


def tool_label(data: dict) -> str:
    """Etichetta leggibile del tool in esecuzione, dal campo 'tool' dell'evento."""
    tool = data.get("tool") or {}
    name = tool.get("tool_name") or "tool"
    args = tool.get("tool_args") or {}
    if args:
        first = str(next(iter(args.values()))).replace("\n", " ⏎ ").replace("`", "")
        return f"{name} `{first[:70]}`"
    return name


def split_for_telegram(text: str, limit: int = 4000) -> list[str]:
    """Telegram limita a 4096 char; lasciamo margine per markdown."""
    if len(text) <= limit:
        return [text]
    chunks, cur = [], ""
    for line in text.split("\n"):
        if len(cur) + len(line) + 1 > limit:
            chunks.append(cur)
            cur = line
        else:
            cur = (cur + "\n" + line) if cur else line
    if cur:
        chunks.append(cur)
    return chunks


bot = telebot.TeleBot(TOKEN)


@bot.message_handler(commands=["start"])
def cmd_start(msg):
    if not is_allowed(msg.from_user.id):
        bot.reply_to(msg, "Accesso non autorizzato.")
        return
    bot.reply_to(msg, (
        "Ciao! Sono {{ identity.name }}. {{ identity.role }} "
        "Scrivi una richiesta per iniziare. /new resetta la conversazione."
    ))


@bot.message_handler(commands=["new"])
def cmd_new(msg):
    if not is_allowed(msg.from_user.id):
        return
    bot.reply_to(msg, "Nuova conversazione. La memoria precedente non sarà più caricata.")


@bot.message_handler(commands=["help"])
def cmd_help(msg):
    if not is_allowed(msg.from_user.id):
        return
    bot.reply_to(msg, (
        "Comandi:\n"
        "/start — saluto + descrizione agente\n"
        "/new — nuova conversazione (reset memoria)\n"
        "/help — questo messaggio\n\n"
        "Scrivi qualsiasi richiesta, l'agente la elabora (vedrai gli step live)."
    ))


@bot.message_handler(func=lambda m: True, content_types=["text"])
def handle_text(msg):
    user_id = msg.from_user.id
    if not is_allowed(user_id):
        bot.reply_to(msg, "Accesso non autorizzato.")
        return

    session_id = f"telegram_{user_id}"
    chat_id = msg.chat.id
    log.info(f"[user {user_id}] {msg.text[:80]}")

    status = bot.send_message(chat_id, "🔧 Elaboro…")
    steps: list[str] = []
    content_acc: list[str] = []
    final_content = ""
    last_edit = [0.0]

    def render() -> str:
        body = "\n".join(steps[-7:]) if steps else "_avvio…_"
        return "🔧 *Sto lavorando…*\n" + body

    def flush(force: bool = False) -> None:
        now = time.monotonic()
        if not force and now - last_edit[0] < EDIT_THROTTLE:
            return
        last_edit[0] = now
        try:
            bot.edit_message_text(render(), chat_id, status.message_id, parse_mode="Markdown")
        except Exception:
            pass  # rate-limit / "not modified" => ignora

    try:
        for name, data in stream_agentos(msg.text, session_id):
            if name == "__error__":
                bot.edit_message_text(f"⚠️ {data.get('content')}", chat_id, status.message_id)
                log.error(f"[user {user_id}] {data.get('content')}")
                return
            if "ToolCallStarted" in name:
                steps.append(f"⏳ {tool_label(data)}")
                flush()
            elif "ToolCallCompleted" in name:
                if steps and steps[-1].startswith("⏳"):
                    steps[-1] = "✓" + steps[-1][1:]
                flush()
            elif "ToolCallError" in name:
                if steps and steps[-1].startswith("⏳"):
                    steps[-1] = "✗" + steps[-1][1:]
                flush(force=True)
            elif name.endswith("RunContent"):
                c = data.get("content")
                if isinstance(c, str):
                    content_acc.append(c)
            elif name.endswith("RunCompleted"):
                c = data.get("content")
                if isinstance(c, str) and c.strip():
                    final_content = c  # l'ultima completion (quella del team) vince
    except Exception as e:
        bot.edit_message_text(f"⚠️ Errore stream: {e}", chat_id, status.message_id)
        log.error(f"[user {user_id}] stream error: {e}")
        return

    content = final_content or "".join(content_acc).strip()
    try:
        bot.edit_message_text("✅ Completato.", chat_id, status.message_id)
    except Exception:
        pass
    if not content:
        bot.send_message(chat_id, "(risposta vuota)")
        return
    for chunk in split_for_telegram(content):
        bot.send_message(chat_id, chunk)
    log.info(f"[user {user_id}] response sent ({len(content)} chars)")


def main():
    me = bot.get_me()
    print(f"\n[bot] @{me.username} online (streaming live)")
    print(f"[bot] AgentOS: {AGENTOS_URL}")
    print(f"[bot] team: {TEAM_ID}")
    print(f"[bot] whitelist: {sorted(ALLOWED_USERS) if ALLOWED_USERS else 'TUTTI (nessuna restrizione)'}")
    print(f"[bot] CTRL+C per fermare\n")
    bot.infinity_polling(timeout=20, long_polling_timeout=20)


if __name__ == "__main__":
    main()
