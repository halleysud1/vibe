"""Model factory: maps model id strings to Agno model instances.

Recognized prefixes: claude-, gpt-, gemini-, deepseek-, glm-.

Reasoning: `resolve_model(id, reasoning=...)` accetta "low" | "medium" | "high".
Il livello NON e' fissato per ruolo: lo decide l'Orchestrator task per task
(vedi ORCHESTRATOR_INSTRUCTIONS e models.reasoning_policy nel manifesto).
Traduzione per provider: effort per Claude 5-family (high -> xhigh; niente
budget_tokens, rimosso dall'API), reasoning_effort per GPT, thinking budget
per Gemini, thinking on/off per DeepSeek/GLM.
I kwargs provider-specifici sono best-effort: se la versione di Agno/provider
non li supporta, il factory ripiega sul modello senza parametro (verifica col
bench, Fase 5.4).

NOTA: questo file è generico — non contiene placeholder. Copialo as-is nel target.
"""

from __future__ import annotations

# Budget di thinking per i provider che ragionano a token (Gemini)
_THINKING_TOKENS = {"low": 1024, "medium": 8192, "high": 24576}

# Claude 5-family: il thinking e' ADATTIVO e la profondita' si controlla con
# l'effort, non coi token. `budget_tokens` e' stato RIMOSSO dall'API (errore
# 400 se inviato) e su alcuni modelli il thinking non e' disattivabile: mai
# inviare "disabled". La scala interna low/medium/high mappa "high" su
# "xhigh", il livello raccomandato per l'agentic coding ("max" resta scelta
# manuale esplicita, non un default della policy).
_CLAUDE_EFFORT = {"low": "low", "medium": "medium", "high": "xhigh"}


def _provider(model_id: str):
    if model_id.startswith("claude-"):
        from agno.models.anthropic import Claude
        return Claude
    if model_id.startswith("gpt-"):
        from agno.models.openai import OpenAIChat
        return OpenAIChat
    if model_id.startswith("gemini-"):
        from agno.models.google import Gemini

        # GOTCHA: il client google-genai abilita l'Automatic Function Calling
        # con tetto DEFAULT di 10 remote calls. Quando e' il framework (Agno)
        # a guidare il tool-loop — come qui — l'AFC e' un limite NASCOSTO che
        # tronca silenziosamente i task multi-tool. Va disabilitato.
        try:
            from google.genai.types import AutomaticFunctionCallingConfig

            class _GeminiNoAFC(Gemini):
                def __init__(self, **kwargs):
                    kwargs.setdefault("generative_model_kwargs", {
                        "automatic_function_calling":
                            AutomaticFunctionCallingConfig(disable=True)
                    })
                    super().__init__(**kwargs)

            return _GeminiNoAFC
        except ImportError:  # SDK senza il tipo: meglio Gemini nudo che crash
            return Gemini
    if model_id.startswith("deepseek-"):
        from agno.models.deepseek import DeepSeek
        return DeepSeek
    if model_id.startswith("glm-"):
        # GLM (Zhipu / Z.ai): endpoint OpenAI-compatible.
        # Env richieste: ZHIPU_API_KEY (+ opzionale ZHIPU_BASE_URL).
        import os
        from agno.models.openai.like import OpenAILike

        class _Zhipu(OpenAILike):
            def __init__(self, **kwargs):
                kwargs.setdefault("api_key", os.getenv("ZHIPU_API_KEY"))
                kwargs.setdefault(
                    "base_url",
                    os.getenv("ZHIPU_BASE_URL", "https://api.z.ai/api/paas/v4"),
                )
                super().__init__(**kwargs)

        return _Zhipu
    raise ValueError(
        f"Unknown model id: '{model_id}'. "
        "Aggiungi un mapping in agent/_models.py per il provider corrispondente."
    )


def _reasoning_kwargs(model_id: str, reasoning: str) -> dict:
    """Traduce low/medium/high nel parametro del provider (best-effort)."""
    if model_id.startswith("gpt-"):
        return {"reasoning_effort": reasoning}
    if model_id.startswith("claude-"):
        # NON usare {"type": "enabled", "budget_tokens": N}: rimosso
        # dall'API sui modelli correnti, risponde 400.
        return {"thinking": {"type": "adaptive"},
                "effort": _CLAUDE_EFFORT[reasoning]}
    if model_id.startswith("gemini-"):
        return {"thinking_budget": _THINKING_TOKENS[reasoning]}
    if model_id.startswith(("deepseek-", "glm-")):
        # deepseek-v4-* e glm-5.x: thinking on/off (niente budget graduato)
        return {"thinking": reasoning != "low"}
    return {}


def resolve_model(model_id: str, reasoning: str | None = None):
    """Map a model id (e.g. 'gemini-3.1-pro-preview') to an Agno model instance.

    reasoning: None | "low" | "medium" | "high" — livello di ragionamento
    richiesto per il task corrente (deciso dall'Orchestrator).
    """
    cls = _provider(model_id)
    if reasoning:
        try:
            return cls(id=model_id, **_reasoning_kwargs(model_id, reasoning))
        except TypeError:
            pass  # provider/versione senza il parametro: fallback pulito
    return cls(id=model_id)
