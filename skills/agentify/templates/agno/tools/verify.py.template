"""Tool verify: esegue la definition-of-done del progetto e riporta l'esito.

E' il cuore del loop di verifica del coding-agent (agentify 4.1.0): dopo ogni
batch di modifiche il ruolo DEVE chiamare verify() e iterare finche' non e'
verde (o fermarsi dopo MAX_VERIFY_CYCLES e proporre/riportare il fallimento).

La definition-of-done e' del PROGETTO, non del modello: comandi oggettivi con
exit code. Renderizzata dal manifesto (tools.definition_of_done).

Quality gates (4.2.0): `verify` cattura "rotto"; per catturare "che degrada"
un check puo' essere una METRICA non-decrescente (`"metric": "non_decreasing"`
+ `"metric_pattern"`, regex con un gruppo di cattura): verify estrae il numero
dall'output e lo confronta con la baseline persistita in docs/ops/.metrics.json
— se scende, il check FALLISCE anche con exit code 0. Il debito tecnico a
velocita' macchina si accumula quando tutto e' verde e la qualita' cala in
silenzio: questi gate rendono il calo visibile.

Un verde chiama `GUARD.mark_progress()`: e' il segnale che azzera il churn
detector, cosi' l'iterazione verificata non viene scambiata per thrashing.
"""
import json
import re
import subprocess

from agent.tools.guard import GUARD, OPS_DIR, PROJECT_ROOT

# CUSTOMIZE dal manifesto. Ogni check: name, command, required
# (+ opzionale "metric": "non_decreasing" con "metric_pattern", una regex con UN
# gruppo di cattura che estrae il numero dall'output).
#
# Due regole imparate sul campo:
# 1. NIENTE PIPE POSIX nei comandi (`| tail`, `| head`, `| grep`): shell=True usa
#    cmd.exe su Windows e il check fallisce sempre. Un check che fallisce sempre
#    ma e' `required: False` non urla: diventa un gate SILENZIOSAMENTE INERTE, e
#    credi di essere coperto quando non lo sei. Estrai col metric_pattern, non
#    con la pipe.
# 2. La metrica non-decrescente va dichiarata `required: True`. Se il progetto
#    non ha coverage, RIMUOVI il check — non degradarlo a informativo.
DEFINITION_OF_DONE = {{ definition_of_done | default('[{"name": "tests", "command": "pytest -q", "required": True}, {"name": "lint", "command": "ruff check .", "required": True}, {"name": "coverage", "command": "pytest -q --cov --cov-report=term", "required": True, "metric": "non_decreasing", "metric_pattern": r"TOTAL\s+(?:\S+\s+)*?(\d+(?:\.\d+)?)%"}]') }}

METRICS_FILE = OPS_DIR / ".metrics.json"
METRIC_TOLERANCE = {{ metric_tolerance | default(0.5) }}  # calo tollerato (es. rumore coverage)

# Oltre questo numero di cicli edit->verify falliti, il ruolo deve FERMARSI
# (riportare il fallimento o proporre in OUTBOX), non insistere alla cieca.
MAX_VERIFY_CYCLES = {{ max_verify_cycles | default(3) }}

_TIMEOUT = {{ verify_timeout_sec | default(600) }}
_TAIL = 2500  # caratteri di coda dell'output per check fallito


def verify(only: str = "") -> str:
    """Run the project's definition-of-done (tests, lint, build) and report.

    - Call this after EVERY batch of edits, before declaring work done.
    - only: optional check name to run a single check (e.g. "tests").
    - Returns "VERDE" if all required checks pass, otherwise "ROSSO" with the
      tail of each failing check's output — read it and fix the actual cause.
    """
    GUARD.gate("verify", {"summary": only or "all"})
    checks = [c for c in DEFINITION_OF_DONE if not only or c["name"] == only]
    if not checks:
        return f"ERROR: nessun check '{only}' nella definition-of-done"
    lines, all_green = [], True
    for c in checks:
        try:
            r = subprocess.run(
                c["command"], shell=True, capture_output=True, text=True,
                timeout=_TIMEOUT, cwd=str(PROJECT_ROOT),
                encoding="utf-8", errors="replace",
            )
            passed = r.returncode == 0
            out_tail = ((r.stdout or "") + (r.stderr or ""))[-_TAIL:].strip()
        except subprocess.TimeoutExpired:
            passed, out_tail = False, f"timeout ({_TIMEOUT}s)"
        if passed and c.get("metric") == "non_decreasing":
            passed, metric_note = _check_metric(c["name"], out_tail,
                                                c.get("metric_pattern"))
            lines_extra = metric_note
        else:
            lines_extra = ""
        if not passed and c.get("required", True):
            all_green = False
        mark = "PASS" if passed else ("FAIL" if c.get("required", True) else "WARN")
        lines.append(f"[{mark}] {c['name']} — {c['command']}"
                     + (f" ({lines_extra})" if lines_extra else ""))
        if not passed:
            lines.append(out_tail or "(nessun output)")
    if all_green:
        # Progresso oggettivo: azzera il churn detector. Molti edit ciascuno
        # verificato sono iterazione, non thrashing (vedi guard.mark_progress).
        GUARD.mark_progress(f"verify VERDE ({only or 'all'})")
    verdict = "VERDE — definition-of-done soddisfatta" if all_green \
        else "ROSSO — correggi e riesegui verify()"
    return verdict + "\n" + "\n".join(lines)


def _check_metric(name, output, pattern=None):
    """Metrica non-decrescente: valore estratto con regex esplicita vs baseline.

    `pattern` DEVE avere un gruppo di cattura col numero. Senza pattern il
    check fallisce invece di indovinare: prendere "l'ultimo numero
    dell'output" e' come fissare la baseline sul tempo di esecuzione dei
    test — poi qualunque coverage la supera e il gate non protegge piu' nulla.
    """
    if not pattern:
        return False, (f"check '{name}' e' una metrica ma non dichiara "
                       "'metric_pattern' (regex con un gruppo di cattura)")
    m = re.search(pattern, output or "", re.MULTILINE)
    if not m:
        return False, f"metric_pattern non trova il valore nell'output di '{name}'"
    try:
        value = float(m.group(1))
    except (IndexError, ValueError):
        return False, f"metric_pattern di '{name}' non cattura un numero valido"
    baselines = {}
    if METRICS_FILE.exists():
        try:
            baselines = json.loads(METRICS_FILE.read_text(encoding="utf-8"))
        except Exception:
            baselines = {}
    baseline = baselines.get(name)
    if baseline is not None and value < baseline - METRIC_TOLERANCE:
        return False, f"metrica scesa: {value} < baseline {baseline}"
    if baseline is None or value > baseline:
        baselines[name] = value
        METRICS_FILE.parent.mkdir(parents=True, exist_ok=True)
        METRICS_FILE.write_text(json.dumps(baselines, indent=1), encoding="utf-8")
    return True, f"{value} (baseline {baseline if baseline is not None else 'nuova'})"
