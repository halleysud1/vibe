"""Bridge LSP del tool layer: code intelligence per il ruolo coding-agent.

Adattato dal tool lsp di opencode (packages/opencode/src/tool/lsp.{ts,txt}
@ commit eb6ff0c1, https://github.com/anomalyco/opencode, MIT License).
Vedi docs/OPENCODE_HARVEST.md.

Client JSON-RPC minimale su stdio verso un LSP server di sistema.
Graceful degradation: se nessun server e' configurato/installato per il
linguaggio, il tool risponde con un messaggio esplicativo (nessun errore).

CUSTOMIZE: mappa estensione -> comando server in LSP_SERVERS.
"""
import json
import subprocess
import threading
from pathlib import Path

from agent.tools.guard import GUARD, PROJECT_ROOT

# CUSTOMIZE dal manifesto (tools.lsp_servers). Esempi comuni:
LSP_SERVERS = {{ lsp_servers | default('{".py": ["pyright-langserver", "--stdio"], ".ts": ["typescript-language-server", "--stdio"]}') }}

_TIMEOUT = 25


class _LspClient:
    def __init__(self, cmd):
        self.proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, cwd=str(PROJECT_ROOT),
        )
        self._id = 0
        self._responses = {}
        self._cv = threading.Condition()
        threading.Thread(target=self._reader, daemon=True).start()
        root_uri = Path(PROJECT_ROOT).as_uri()
        self._request("initialize", {
            "processId": None, "rootUri": root_uri,
            "capabilities": {}, "workspaceFolders": [{"uri": root_uri, "name": "root"}],
        })
        self._notify("initialized", {})

    def _send(self, payload):
        data = json.dumps(payload).encode("utf-8")
        self.proc.stdin.write(f"Content-Length: {len(data)}\r\n\r\n".encode() + data)
        self.proc.stdin.flush()

    def _notify(self, method, params):
        self._send({"jsonrpc": "2.0", "method": method, "params": params})

    def _request(self, method, params):
        self._id += 1
        rid = self._id
        self._send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
        with self._cv:
            if not self._cv.wait_for(lambda: rid in self._responses, timeout=_TIMEOUT):
                raise TimeoutError(f"LSP timeout su {method}")
            return self._responses.pop(rid)

    def _reader(self):
        try:
            while True:
                headers = {}
                while True:
                    line = self.proc.stdout.readline()
                    if not line:
                        return
                    line = line.decode("utf-8", "replace").strip()
                    if not line:
                        break
                    k, _, v = line.partition(":")
                    headers[k.lower()] = v.strip()
                body = self.proc.stdout.read(int(headers.get("content-length", 0)))
                msg = json.loads(body.decode("utf-8", "replace"))
                if "id" in msg and ("result" in msg or "error" in msg):
                    with self._cv:
                        self._responses[msg["id"]] = msg.get("result", msg.get("error"))
                        self._cv.notify_all()
        except Exception:
            return

    def did_open(self, path):
        p = Path(path)
        self._notify("textDocument/didOpen", {"textDocument": {
            "uri": p.as_uri(), "languageId": p.suffix.lstrip("."),
            "version": 1, "text": p.read_text(encoding="utf-8", errors="replace"),
        }})

    def close(self):
        try:
            self.proc.terminate()
        except Exception:
            pass


_clients = {}


def _client_for(file_path):
    ext = Path(file_path).suffix
    cmd = LSP_SERVERS.get(ext)
    if not cmd:
        return None, f"nessun LSP server configurato per '{ext}' (vedi LSP_SERVERS)"
    key = tuple(cmd)
    if key not in _clients:
        try:
            _clients[key] = _LspClient(cmd)
        except FileNotFoundError:
            return None, f"LSP server non installato: {cmd[0]}"
    return _clients[key], None


def _positional(file_path, line, character, method):
    GUARD.gate("lsp", {"file_path": file_path, "summary": method})
    p = Path(file_path)
    p = p if p.is_absolute() else PROJECT_ROOT / p
    client, err = _client_for(str(p))
    if err:
        return f"LSP non disponibile: {err}"
    try:
        client.did_open(str(p))
        result = client._request(method, {
            "textDocument": {"uri": p.as_uri()},
            "position": {"line": line - 1, "character": character - 1},
        })
        return json.dumps(result, ensure_ascii=False, indent=1)[:8000] or "(nessun risultato)"
    except TimeoutError as e:
        return f"LSP: {e}"


def lsp_definition(file_path: str, line: int, character: int) -> str:
    """Find where the symbol at the given position is defined (LSP
    goToDefinition). line/character are 1-based, as shown in editors."""
    return _positional(file_path, line, character, "textDocument/definition")


def lsp_references(file_path: str, line: int, character: int) -> str:
    """Find all references to the symbol at the given position (LSP
    findReferences). line/character are 1-based."""
    GUARD.gate("lsp", {"file_path": file_path, "summary": "references"})
    p = Path(file_path)
    p = p if p.is_absolute() else PROJECT_ROOT / p
    client, err = _client_for(str(p))
    if err:
        return f"LSP non disponibile: {err}"
    try:
        client.did_open(str(p))
        result = client._request("textDocument/references", {
            "textDocument": {"uri": p.as_uri()},
            "position": {"line": line - 1, "character": character - 1},
            "context": {"includeDeclaration": True},
        })
        return json.dumps(result, ensure_ascii=False, indent=1)[:8000] or "(nessun risultato)"
    except TimeoutError as e:
        return f"LSP: {e}"


def lsp_document_symbols(file_path: str) -> str:
    """List all symbols (functions, classes, variables) in a document (LSP
    documentSymbol). Useful to get a structural overview before editing."""
    GUARD.gate("lsp", {"file_path": file_path, "summary": "documentSymbol"})
    p = Path(file_path)
    p = p if p.is_absolute() else PROJECT_ROOT / p
    client, err = _client_for(str(p))
    if err:
        return f"LSP non disponibile: {err}"
    try:
        client.did_open(str(p))
        result = client._request("textDocument/documentSymbol",
                                 {"textDocument": {"uri": p.as_uri()}})
        return json.dumps(result, ensure_ascii=False, indent=1)[:8000] or "(nessun risultato)"
    except TimeoutError as e:
        return f"LSP: {e}"
