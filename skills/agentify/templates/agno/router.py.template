"""Router/triage del messaggio in arrivo — pattern "loop a due corsie".

Decide se un messaggio è **chat** (corsia veloce: conversazione, nessun tool,
modello con thinking ridotto) o **ops** (corsia operativa: loop completo con
tool e reasoning). È architecture-agnostic: lo usi sia con l'agente in-process
(`agent.run(...)`) sia col bot che parla ad AgentOS via HTTP — cambia solo
*cosa* fai dopo aver ottenuto la rotta.

Strategia ibrida:
1. Euristica gratuita (regex) per i casi netti — saluti/domande generiche =>
   chat; verbi d'azione / token CLI / nomi di skill => ops.
2. Solo per gli ambigui, una micro-call al modello veloce (nessun tool). Se
   fallisce, fail-safe su ``ops`` (meglio agire che ignorare una richiesta reale).

NOTA: personalizza `_ACTION` / `_CHATTY` coi verbi e i nomi-skill del TUO
dominio. Sono il primo posto da tarare se il router sbaglia a classificare.
"""

from __future__ import annotations

import os
import re

# Saluti/cortesie puri (match sull'intera riga) => chat.
_GREET = re.compile(
    r"^(ciao|salve|buongiorno|buonasera|buonanotte|hey|ehi|grazie( mille)?|"
    r"ok(ay)?|perfetto|ottimo|bene|👍|🙏|👌)[\s!.,…]*$",
    re.IGNORECASE,
)

# Domande generiche su identità/capacità => chat.
_CHATTY = re.compile(
    r"\b(chi sei|cosa (puoi|sai) fare|cosa fai|come (stai|va|funzioni)|"
    r"che (cosa )?sei|aiuto|spiegami chi sei)\b",
    re.IGNORECASE,
)

# Segnali d'azione operativa => loop completo. <-- PERSONALIZZA per il dominio.
_ACTION = re.compile(
    r"\b(esegui|lancia|avvia|riavvia|calcola|genera|crea|modifica|cambia|"
    r"aggiungi|rimuov\w*|cancell\w*|aggiorna|analizz\w*|valida|esporta|stampa|"
    r"installa|testa|controlla|verifica|fai|fammi|dammi|mostrami|"
    r"pytest|python|git)\b",
    re.IGNORECASE,
)

_CLI_HEADS = ("python", "git", "pytest", "./", ".\\")

# Micro-modello per la disambiguazione (override via env). Usa un modello
# piccolo/economico: il router viene chiamato a ogni messaggio ambiguo.
_ROUTER_MODEL = os.getenv("ROUTER_MODEL", "gemini-2.5-flash-lite")
_ROUTER_PROMPT = (
    "Sei un classificatore di intenti. Decidi se il messaggio è CHAT "
    "(chiacchiera, saluto, ringraziamento, domanda generica sull'agente o sulle "
    "sue capacità) oppure OPS (richiede un'azione concreta: eseguire comandi/CLI/"
    "test/script, leggere o modificare file, operazioni sul progetto, git). "
    "Rispondi con UNA sola parola: CHAT o OPS."
)

_router_agent = None


def _llm_classify(text: str) -> str:
    global _router_agent
    try:
        if _router_agent is None:
            from agno.agent import Agent

            from agent._models import resolve_model

            _router_agent = Agent(
                name="Router",
                model=resolve_model(_ROUTER_MODEL),
                tools=[],
                instructions=_ROUTER_PROMPT,
                markdown=False,
            )
        resp = _router_agent.run(text)
        out = (getattr(resp, "content", "") or "").strip().upper()
        return "chat" if out.startswith("CHAT") else "ops"
    except Exception:
        return "ops"  # fail-safe: meglio agire che ignorare una richiesta operativa


def classify(text: str) -> str:
    """Ritorna ``"chat"`` o ``"ops"`` per il messaggio dato."""
    t = (text or "").strip()
    if not t:
        return "chat"
    low = t.lower()
    if _GREET.match(low) or _CHATTY.search(low):
        return "chat"
    if _ACTION.search(low) or ".py" in low or low.startswith(_CLI_HEADS):
        return "ops"
    return _llm_classify(t)


__all__ = ["classify"]
