def _safe_print(text: str) -> None:
    """print() a prova di console non-UTF8 (stdout del daemon rediretto su file:
    su Windows diventa cp1252 e un'emoji ucciderebbe il runner)."""
    try:
        print(text)
    except UnicodeEncodeError:
        enc = sys.stdout.encoding or "ascii"
        print(text.encode(enc, "replace").decode(enc, "replace"))


def notify(run: dict, text: str) -> None:
    msg = f"[ricerca {run['run_id']}]\n{text}"
    _log(run, f"notifica: {text[:120]}")
    if run.get("notify_to"):
        try:
            _notify(run["notify_to"], msg)
        except Exception as e:  # una notifica fallita non deve fermare la pipeline
            _log(run, f"notifica fallita: {e}")
    else:
        _safe_print(f"[pipeline] {msg}")


# ------------------------------------------------------------------ i dubbi

def open_structural(run: dict) -> list[dict]:
    return [d for d in run.get("dubbi", [])
            if d.get("classe") == "strutturale" and d.get("esito") == "aperto"]


def _render_dubbi(dubbi: list[dict]) -> str:
    if not dubbi:
        return "(nessuno)"
    return "\n".join(
        f"- [{d.get('classe', '?')}/{d.get('esito', '?')}] {d.get('enunciato', '')}"
        f"{' — ' + d['note'] if d.get('note') else ''}"
        f"{' (' + d['fonte'] + ')' if d.get('fonte') else ''}"
        for d in dubbi)


def _merge_dubbi(run: dict, nuovi: list[dict]) -> tuple[int, int]:
    """Fonde i dubbi del cancello nel registro. Match per enunciato normalizzato.

    Ritorna (chiusi_in_questo_giro, nuovi_aperti). Un dubbio che sparisce dalla
    risposta dell'LLM NON viene rimosso: resta nel registro col suo esito
    precedente. I dubbi non evaporano.
    """
    def key(d: dict) -> str:
        return re.sub(r"\W+", " ", (d.get("enunciato") or "").lower()).strip()

    esistenti = {key(d): d for d in run["dubbi"]}
    chiusi = nuovi_aperti = 0
    for d in nuovi:
        k = key(d)
        if not k:
            continue
        d.setdefault("esito", "aperto")
        d.setdefault("classe", "strutturale")  # default prudente
        if k in esistenti:
            prev = esistenti[k]
            if prev.get("esito") == "aperto" and d["esito"] == "chiuso":
                chiusi += 1
            prev.update({x: y for x, y in d.items() if y not in (None, "")})
        else:
            d["visto_da"] = run.get("stage")
            run["dubbi"].append(d)
            esistenti[k] = d
            if d["esito"] == "aperto":
                nuovi_aperti += 1
    return chiusi, nuovi_aperti


def _extract_json(text: str) -> dict | None:
    """Estrae il primo oggetto JSON dal testo (tollera fence markdown e preamboli)."""
    fence = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.S)
    candidate = fence.group(1) if fence else None
    if candidate is None:
        start = text.find("{")
        end = text.rfind("}")
        candidate = text[start:end + 1] if 0 <= start < end else None
    if not candidate:
        return None
    try:
        data = json.loads(candidate)
        return data if isinstance(data, dict) else None
    except ValueError:
        return None


# --------------------------------------------------------------- state machine

def _stage_json(run: dict, stage: str) -> str:
    return run["rounds"].get(stage, {}).get("json", "")


def _last_json(run: dict) -> str:
    done = [r["json"] for r in run["rounds"].values() if r.get("completed_at")]
    return done[-1] if done else ""


def _all_json(run: dict) -> str:
    return ", ".join(r["json"] for r in run["rounds"].values() if r.get("completed_at"))


def _fmt(run: dict, template: str) -> str:
    stage = run.get("stage", "")
    return template.format(
        run_id=run["run_id"],
        topic=run["topic"],
        soggetto=run["soggetto"],
        slug=_slug(run["topic"]),
        date=datetime.now().strftime("%Y-%m-%d"),
        stage=stage,
        last_json=_last_json(run),
        round_json_list=_all_json(run),
        dubbi_aperti=_render_dubbi(open_structural(run)),
        dubbi_tracciati=_render_dubbi(run.get("dubbi", [])),
        controllo=(run["artifacts"].get(f"controllo_{stage}", "") or "")[:8000],
        confronto=(run["artifacts"].get(f"confronto_{stage}", "") or "")[:8000],
        ranking=(run["artifacts"].get("ranking", "") or "")[:8000],
    )


def advance(run: dict) -> dict:
    """Fa avanzare il run di UN passo, se c'e' qualcosa da fare. Salva sempre."""
    state = run["state"]
    if state in TERMINAL_STATES or state in HUMAN_STATES:
        return run  # in attesa_decisione il runner non tocca nulla: decide un umano
    try:
        if state == "compose":
            _advance_compose(run)
        elif state == "wait":
            _advance_wait(run)
        elif state in ("controllo", "confronto"):
            _advance_verifica(run)
        elif state == "cancello":
            _advance_cancello(run)
        elif state in _POST:
            _advance_post(run)
        else:
            _fail(run, f"stato sconosciuto: {state}")
    except Exception as e:  # un run rotto non deve uccidere il runner
        _retry_or_fail(run, f"eccezione in {state}: {e}")
    save_run(run)
    return run


def _advance_compose(run: dict) -> None:
    kind = run["stage_kind"]
    instruction = (
        f"[PIPELINE {run['run_id']} — step automatico, NON e' un utente in chat. "
        f"Rispondi con il SOLO testo del prompt richiesto, senza preamboli.]\n\n"
        f"Tema: {run['topic']}\nSoggetto: {run['soggetto']}\n"
        f"Stadio: {STAGE_LABELS[kind]} ({run['stage']})\n\n"
        + _fmt(run, COMPOSE_INSTRUCTIONS[kind])
    )
    ok, prompt_text = _llm_call(instruction, session_id=f"pipeline_{run['run_id']}")
    # Un prompt di ricerca serio non sta in 200 caratteri: soglia anti-risposta-vuota.
    if not ok or len(prompt_text.strip()) < 200:
        _retry_or_fail(run, f"composizione prompt {run['stage']} fallita: "
                            f"{(prompt_text or 'risposta vuota')[:200]}")
        return
    if "{{" in prompt_text:
        _retry_or_fail(run, f"prompt {run['stage']} con segnaposto non sostituiti")
        return

    RESEARCH_DIR.mkdir(parents=True, exist_ok=True)
    tag = f"{run['run_id']}_{run['stage']}"
    prompt_file = RESEARCH_DIR / f"{tag}_prompt.md"
    out_json = RESEARCH_DIR / f"{tag}.json"
    log_file = RESEARCH_DIR / f"{tag}.log"
    prompt_file.write_text(prompt_text.strip(), encoding="utf-8")
    pid = _launch_research(prompt_file, out_json, log_file)

    run["rounds"][run["stage"]] = {
        "stage_kind": run["stage_kind"],
        "tag": tag,
        "prompt_file": prompt_file.relative_to(PROJECT_ROOT).as_posix(),
        "json": out_json.relative_to(PROJECT_ROOT).as_posix(),
        "log": log_file.relative_to(PROJECT_ROOT).as_posix(),
        "pid": pid,
        "started_at": _now(),
    }
    run["state"], run["attempts"] = "wait", 0
    _log(run, f"{run['stage']} lanciato (pid {pid})")
    extra = ""
    if run["stage_kind"] == KIND_DUBBI:
        extra = (f"\nDubbi da chiudere:\n{_render_dubbi(open_structural(run))}"
                 f"\nRicorsione: {run['n_round_dubbi']}/{run['limite_ricorsione']}")
    notify(run, f"▶️ {STAGE_LABELS[run['stage_kind']]} ({run['stage']}): ricerca "
                f"avviata (tipicamente 10-40 min). Ti avviso al termine.{extra}")


def _advance_wait(run: dict) -> None:
    info = run["rounds"].get(run["stage"])
    if not info:  # incoerenza di stato: torna a comporre
        run["state"] = "compose"
        return

    out_json = PROJECT_ROOT / info["json"]
    if out_json.exists():
        try:
            d = json.loads(out_json.read_text(encoding="utf-8"))
        except Exception as e:
            _retry_or_fail(run, f"output {run['stage']} illeggibile: {e}")
            return
        chars = d.get("response_chars", len(d.get("response_text", "")))
        status = d.get("status", "unknown")
        info.update({"completed_at": _now(), "chars": chars, "status": status,
                     "citations": d.get("citations_count")})
        if status != "completed" or chars == 0:
            _fail(run, f"{run['stage']} terminato con status={status} e {chars} "
                       f"caratteri: intervento umano necessario.")
            return
        run["state"], run["attempts"] = "controllo", 0
        _log(run, f"{run['stage']} completato ({chars} caratteri)")
        notify(run, f"✅ {STAGE_LABELS[run['stage_kind']]} ({run['stage']}) "
                    f"completato: {chars} caratteri, {info.get('citations')} "
                    f"citazioni. Passo al controllo delle fonti.")
        return

    elapsed_min = (datetime.now() - datetime.fromisoformat(info["started_at"])).total_seconds() / 60
    if elapsed_min > MAX_ROUND_MINUTES:
        tail = ""
        log_p = PROJECT_ROOT / info["log"]
        if log_p.exists():
            tail = "\n".join(log_p.read_text(encoding="utf-8", errors="replace").splitlines()[-4:])
        _fail(run, f"{run['stage']} oltre il tempo massimo ({MAX_ROUND_MINUTES} min). "
                   f"Il task potrebbe essere ancora vivo: cerca l'interaction_id nel "
                   f"log e riprendilo con --resume-id.\nUltime righe:\n{tail}")
    # altrimenti: ancora in corso, si ricontrolla al prossimo giro


def _advance_verifica(run: dict) -> None:
    """Controllo (Fase 4) e confronto (Fase 5): stessa meccanica, artefatto per stadio."""
    state = run["state"]
    template = CONTROLLO_INSTRUCTION if state == "controllo" else CONFRONTO_INSTRUCTION
    prompt = (f"[PIPELINE {run['run_id']} — step automatico, NON e' un utente in chat.]"
              f"\n\n" + _fmt(run, template))
    ok, text = _llm_call(prompt, session_id=f"pipeline_{run['run_id']}")
    if not ok or not text.strip():
        _retry_or_fail(run, f"step {state} su {run['stage']} fallito: {(text or '')[:200]}")
        return
    run["artifacts"][f"{state}_{run['stage']}"] = text.strip()
    run["state"] = "confronto" if state == "controllo" else "cancello"
    run["attempts"] = 0
    _log(run, f"{state} su {run['stage']} completato ({len(text)} caratteri)")


def _advance_cancello(run: dict) -> None:
    """Il cancello: l'LLM classifica i dubbi, il CODICE decide il routing."""
    prompt = (f"[PIPELINE {run['run_id']} — step automatico, NON e' un utente in chat.]"
              f"\n\n" + _fmt(run, CANCELLO_INSTRUCTION))
    ok, text = _llm_call(prompt, session_id=f"pipeline_{run['run_id']}")
    if not ok:
        _retry_or_fail(run, f"cancello su {run['stage']} fallito: {(text or '')[:200]}")
        return

    data = _extract_json(text or "")
    if data is None or not isinstance(data.get("dubbi"), list):
        # Fallback SEMPRE verso l'umano: mai "vai avanti" su un cancello illeggibile.
        _to_human(run, "il cancello non ha prodotto un JSON valido: non posso "
                       "classificare i dubbi da solo.\n\nRisposta grezza:\n"
                  + (text or "")[:1500])
        return

    chiusi, nuovi = _merge_dubbi(run, data["dubbi"])
    sintesi = (data.get("sintesi") or "").strip()
    aperti = open_structural(run)
    _log(run, f"cancello su {run['stage']}: {len(aperti)} strutturali aperti, "
              f"{chiusi} chiusi, {nuovi} nuovi")

    focus_fatto = any(r.get("stage_kind") == KIND_FOCUS for r in run["rounds"].values())

    # ---- politica deterministica di routing ----
    if aperti and run["n_round_dubbi"] < run["limite_ricorsione"]:
        run["n_round_dubbi"] += 1
        run["stage"] = f"r2-dubbi{run['n_round_dubbi']}"
        run["stage_kind"] = KIND_DUBBI
        run["state"], run["attempts"] = "compose", 0
        notify(run, f"🔁 {len(aperti)} dubbio/i strutturale/i aperto/i: non stringo "
                    f"l'imbuto. Apro un round di dubbi "
                    f"({run['n_round_dubbi']}/{run['limite_ricorsione']}).\n"
                    f"{_render_dubbi(aperti)}\n\n{sintesi}")
        return

    if aperti:  # limite esaurito con dubbi aperti: NON si stringe
        _to_human(run, f"limite di ricorsione esaurito "
                       f"({run['n_round_dubbi']}/{run['limite_ricorsione']}) con "
                       f"{len(aperti)} dubbio/i strutturale/i ancora aperto/i:\n"
                  + _render_dubbi(aperti)
                  + "\n\nNon proseguo da solo: stringere su un dubbio aperto e' "
                    "esattamente cio' che questo funnel esiste per evitare.")
        return

    if not focus_fatto:
        run["stage"], run["stage_kind"] = "r3-focus", KIND_FOCUS
        run["state"], run["attempts"] = "compose", 0
        notify(run, f"✅ Nessun dubbio strutturale aperto ({chiusi} chiusi in questo "
                    f"giro). Stringo sul verticale.\n\n{sintesi}")
        return

    run["state"], run["attempts"] = POST_STEPS[0]["state"], 0
    notify(run, f"✅ Funnel chiuso, dubbi risolti. Passo a ranking e "
                f"sinottico.\n\n{sintesi}")


def _advance_post(run: dict) -> None:
    next_state, artifact_key, template = _POST[run["state"]]
    prompt = (f"[PIPELINE {run['run_id']} — step automatico, NON e' un utente in chat.]"
              f"\n\n" + _fmt(run, template))
    ok, text = _llm_call(prompt, session_id=f"pipeline_{run['run_id']}")
    if not ok or not text.strip():
        _retry_or_fail(run, f"step {run['state']} fallito: {(text or '')[:200]}")
        return
    run["artifacts"][artifact_key] = text.strip()
    prev_state = run["state"]
    run["state"], run["attempts"] = next_state, 0
    _log(run, f"{prev_state} completato ({len(text)} caratteri)")
    if next_state == "done":
        aperti = [d for d in run["dubbi"] if d.get("esito") == "aperto"]
        coda = (f"\n\n⚠️ Dubbi rimasti aperti: {len(aperti)}\n{_render_dubbi(aperti)}"
                if aperti else "")
        notify(run, f"🏁 Ricerca completata.\n\n{text.strip()[:3000]}{coda}")
    else:
        notify(run, f"✅ {prev_state} completato. Proseguo con {next_state}.")


# ------------------------------------------------------- decisione umana

def _to_human(run: dict, reason: str) -> None:
    """Mette il run in attesa di una decisione umana. Non e' un errore."""
    run["state"] = "attesa_decisione"
    run["decisione"] = None
    run["attempts"] = 0
    _log(run, f"attesa decisione: {reason[:300]}")
    notify(run, f"⏸️ Run in pausa, serve una tua decisione.\n\n{reason}\n\n"
                f"Opzioni: 'altro-round' (concedi un round di dubbi in piu') · "
                f"'procedi' (vai al verticale accettando il rischio) · "
                f"'chiudi' (sinottico parziale coi dubbi aperti dichiarati).")


def decide(run_id: str, scelta: str, deciso_da: str = "") -> str:
    """Sblocca un run in attesa_decisione. scelta: altro-round | procedi | chiudi."""
    run = load_run(run_id)
    if not run:
        return f"run non trovato: {run_id}"
    if run["state"] != "attesa_decisione":
        return f"run {run_id} non e' in attesa di decisione (stato: {run['state']})"

    scelta = (scelta or "").strip().lower()
    focus_fatto = any(r.get("stage_kind") == KIND_FOCUS for r in run["rounds"].values())

    if scelta == "altro-round":
        run["limite_ricorsione"] += 1
        run["n_round_dubbi"] += 1
        run["stage"] = f"r2-dubbi{run['n_round_dubbi']}"
        run["stage_kind"] = KIND_DUBBI
        run["state"] = "compose"
        esito = f"concesso un round di dubbi in piu' (limite ora {run['limite_ricorsione']})"
    elif scelta == "procedi":
        # Decisione esplicita di stringere su dubbi aperti: va tracciata per sempre.
        run["stretto_su_dubbi_aperti"] = True
        if focus_fatto:
            run["state"] = POST_STEPS[0]["state"]
            esito = "procedo a ranking e sinottico con i dubbi aperti dichiarati"
        else:
            run["stage"], run["stage_kind"] = "r3-focus", KIND_FOCUS
            run["state"] = "compose"
            esito = "procedo al verticale accettando il rischio dei dubbi aperti"
    elif scelta == "chiudi":
        run["stretto_su_dubbi_aperti"] = False
        run["state"] = POST_STEPS[0]["state"]
        esito = "chiudo con sinottico parziale, dubbi aperti dichiarati"
    else:
        return ("scelta non valida. Usa: altro-round | procedi | chiudi")

    run["decisione"] = {"scelta": scelta, "da": str(deciso_da), "quando": _now()}
    run["attempts"] = 0
    _log(run, f"decisione umana '{scelta}' da {deciso_da or 'n/d'}: {esito}")
    save_run(run)
    notify(run, f"▶️ Decisione registrata: {esito}. Riprendo.")
    return f"OK: {esito}"


def _retry_or_fail(run: dict, reason: str) -> None:
    run["attempts"] = run.get("attempts", 0) + 1
    _log(run, f"tentativo {run['attempts']}/{MAX_ATTEMPTS} fallito: {reason[:300]}")
    if run["attempts"] >= MAX_ATTEMPTS:
        _fail(run, reason)


def _fail(run: dict, reason: str) -> None:
    run["state"], run["error"] = "error", reason[:1000]
    _log(run, f"ERRORE: {reason[:300]}")
    notify(run, f"❌ Pipeline in errore: {reason[:500]}\nNessun retry automatico: "
                f"serve una decisione umana.")


def cancel(run_id: str) -> bool:
    """Marca il run come annullato. NB: un Deep Research gia' lanciato prosegue
    server-side — l'artefatto verra' semplicemente ignorato."""
    run = load_run(run_id)
    if not run or run["state"] in TERMINAL_STATES:
        return False
    run["state"] = "cancelled"
    _log(run, "annullato su richiesta")
    save_run(run)
    return True


def status_text(run: dict) -> str:
    lines = [f"run: {run['run_id']}  [{run['state']}]  stadio: {run.get('stage')}",
             f"tema: {run['topic']}",
             f"creato: {run['created_at']}  aggiornato: {run['updated_at']}",
             f"ricorsione: {run.get('n_round_dubbi', 0)}/{run.get('limite_ricorsione', '?')} round di dubbi"]
    for stage, info in run["rounds"].items():
        when = (f"completato {info.get('completed_at')} ({info.get('chars')} car.)"
                if info.get("completed_at") else f"in corso da {info.get('started_at')}")
        lines.append(f"  {stage}: {when} → {info['json']}")
    dubbi = run.get("dubbi", [])
    if dubbi:
        aperti = [d for d in dubbi if d.get("esito") == "aperto"]
        lines.append(f"  dubbi: {len(dubbi)} tracciati, {len(aperti)} aperti "
                     f"({len(open_structural(run))} strutturali)")
        for d in aperti:
            lines.append(f"    - [{d.get('classe')}] {d.get('enunciato', '')[:90]}")
    for key in ("ranking", "report"):
        if key in run.get("artifacts", {}):
            lines.append(f"  {key}: fatto ({len(run['artifacts'][key])} caratteri)")
    if run.get("stretto_su_dubbi_aperti"):
        lines.append("  ATTENZIONE: verticale eseguito su dubbi aperti per decisione umana")
    if run.get("error"):
        lines.append(f"  errore: {run['error'][:300]}")
    return "\n".join(lines)


# --------------------------------------------------------------------- runner

class PipelineRunner(threading.Thread):
    """Thread daemon: ogni POLL_SECONDS avanza di un passo tutti i run attivi.

    I run in `attesa_decisione` restano attivi ma non vengono avanzati: aspettano
    `decide()`. Il runner non decide mai al posto dell'umano.
    """

    def __init__(self, poll_seconds: int = POLL_SECONDS):
        super().__init__(name="pipeline-runner", daemon=True)
        self.poll_seconds = poll_seconds
        self._stop = threading.Event()

    def run(self) -> None:
        active = list_runs(active_only=True)
        if active:
            waiting = [r["run_id"] for r in active if r["state"] in HUMAN_STATES]
            _safe_print(f"[pipeline] resume: {len(active)} run attivi"
                        + (f", in attesa di decisione: {', '.join(waiting)}" if waiting else ""))
        while not self._stop.is_set():
            for r in list_runs(active_only=True):
                try:
                    advance(r)
                except Exception as e:
                    _safe_print(f"[pipeline] errore su {r.get('run_id')}: {e}")
            self._stop.wait(self.poll_seconds)

    def stop(self) -> None:
        self._stop.set()


# ------------------------------------------------------------------- CLI ops
# Utile per far girare la pipeline senza l'agente (debug, cron, primo test).

def _cli(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print("uso: pipeline.py new '<tema>' [--limite N] | list | status <run_id> | "
              "advance <run_id> | decide <run_id> <altro-round|procedi|chiudi> | "
              "cancel <run_id> | serve")
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "new":
        limite = None
        if "--limite" in rest:
            i = rest.index("--limite")
            limite = int(rest[i + 1])
            rest = rest[:i] + rest[i + 2:]
        if not rest:
            print("serve il tema", file=sys.stderr)
            return 2
        print(status_text(new_run(" ".join(rest), max_doubt_rounds=limite)))
        return 0
    if cmd == "list":
        for r in list_runs():
            flag = " <-- ATTESA DECISIONE" if r["state"] in HUMAN_STATES else ""
            print(f"{r['run_id']:40s} {r['state']:18s} {r.get('stage', ''):16s} "
                  f"{r['topic'][:30]}{flag}")
        return 0
    if cmd == "decide":
        if len(rest) < 2:
            print("uso: decide <run_id> <altro-round|procedi|chiudi>", file=sys.stderr)
            return 2
        print(decide(rest[0], rest[1], deciso_da="cli"))
        return 0
    if cmd in ("status", "advance", "cancel"):
        if not rest:
            print("serve il run_id", file=sys.stderr)
            return 2
        run = load_run(rest[0])
        if not run:
            print(f"run non trovato: {rest[0]}", file=sys.stderr)
            return 2
        if cmd == "status":
            print(status_text(run))
        elif cmd == "advance":
            print(status_text(advance(run)))
        else:
            print("annullato" if cancel(rest[0]) else "non annullabile")
        return 0
    if cmd == "serve":
        runner = PipelineRunner()
        runner.start()
        _safe_print(f"[pipeline] runner avviato (poll {POLL_SECONDS}s). Ctrl-C per uscire.")
        try:
            while runner.is_alive():
                time.sleep(1)
        except KeyboardInterrupt:
            runner.stop()
        return 0
    print(f"comando sconosciuto: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(_cli(sys.argv[1:]))
