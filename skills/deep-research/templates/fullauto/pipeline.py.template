# ------------------------------------------------------------------- run store

def _now() -> str:
    return datetime.now().isoformat(timespec="seconds")


def _slug(text: str, maxlen: int = 30) -> str:
    s = "".join(c if c.isalnum() else "-" for c in text.lower())
    return re.sub(r"-+", "-", s).strip("-")[:maxlen] or "ricerca"


def new_run(topic: str, soggetto: str = "{{ soggetto_default }}",
            notify_to: str | int | None = None, created_by: str = "",
            max_doubt_rounds: int | None = None) -> dict:
    """Crea e persiste un nuovo run nello stadio 1."""
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    base = f"{datetime.now().strftime('%Y%m%d')}_{_slug(topic)}"
    run_id, n = base, 1
    while (RUNS_DIR / f"{run_id}.json").exists():
        n += 1
        run_id = f"{base}-{n}"
    run = {
        "run_id": run_id,
        "topic": topic,
        "soggetto": soggetto,
        "state": "compose",
        "stage": "r1-inquadramento",
        "stage_kind": KIND_INQUADRAMENTO,
        "notify_to": notify_to,
        "created_by": str(created_by),
        "attempts": 0,
        # Limite dichiarato ALLA CREAZIONE, non deciso strada facendo.
        "limite_ricorsione": MAX_DOUBT_ROUNDS if max_doubt_rounds is None else max_doubt_rounds,
        "n_round_dubbi": 0,
        "rounds": {},      # stage -> {tag, prompt_file, json, log, pid, started_at, ...}
        "artifacts": {},   # controllo/confronto per stadio + ranking/report
        "dubbi": [],       # registro: enunciato, classe, esito, fonte, emerso_da, note
        "decisione": None,  # riempita da decide() quando serve un umano
        "log": [],
        "error": None,
        "created_at": _now(),
        "updated_at": _now(),
    }
    _log(run, f"run creato: topic='{topic}', soggetto='{soggetto}', "
              f"limite ricorsione={run['limite_ricorsione']}")
    save_run(run)
    return run


def run_path(run_id: str) -> Path:
    return RUNS_DIR / f"{run_id}.json"


def load_run(run_id: str) -> dict | None:
    p = run_path(run_id)
    return json.loads(p.read_text(encoding="utf-8")) if p.exists() else None


def save_run(run: dict) -> None:
    run["updated_at"] = _now()
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    tmp = run_path(run["run_id"]).with_suffix(".tmp")
    tmp.write_text(json.dumps(run, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(run_path(run["run_id"]))  # atomica: mai un JSON mezzo scritto


def list_runs(active_only: bool = False) -> list[dict]:
    if not RUNS_DIR.exists():
        return []
    runs = []
    for p in sorted(RUNS_DIR.glob("*.json")):
        try:
            r = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if active_only and r.get("state") in TERMINAL_STATES:
            continue
        runs.append(r)
    return runs


def _log(run: dict, line: str) -> None:
    run["log"].append(f"[{_now()}] {line}")


# ------------------------------------------------------- giunture con l'esterno

def _llm_call(prompt: str, session_id: str, timeout: int = LLM_TIMEOUT) -> tuple[bool, str]:
    """Delega uno step di sintesi all'LLM/agente del progetto. Ritorna (ok, testo).

    TODO durante lo scaffolding: sostituire con la chiamata reale. Esempio con un
    AgentOS locale:

        import requests
        url = os.getenv("AGENTOS_URL", "http://localhost:7777")
        team = os.getenv("PIPELINE_TEAM_ID", "{{ team_id }}")
        resp = requests.post(f"{url}/teams/{team}/runs", files={
            "message": (None, prompt), "stream": (None, "false"),
            "monitor": (None, "false"), "session_id": (None, session_id)}, timeout=timeout)
        if resp.status_code != 200:
            return False, f"HTTP {resp.status_code}: {resp.text[:300]}"
        return True, resp.json().get("content", "")

    L'agente chiamato deve avere `read_file` / `write_file` / `web_fetch`: gli step
    leggono i JSON dei round dal disco, non li ricevono nel prompt (sarebbero decine
    di migliaia di caratteri).
    """
    raise NotImplementedError("collega _llm_call all'LLM del progetto")


def _launch_research(prompt_file: Path, out_json: Path, log_file: Path) -> int:
    """Avvia deep_research.py DETACHED e ritorna il pid.

    Detached e' essenziale: il processo deve sopravvivere al turno che lo lancia e a
    un riavvio del runner.
    """
    cmd = [sys.executable, str(DR_SCRIPT),
           "--prompt-file", str(prompt_file),
           "--output-json", str(out_json),
           "--log-file", str(log_file),
           "--max-wait", str(MAX_ROUND_MINUTES * 60)]
    agent = os.getenv("DEEPRESEARCH_AGENT")
    if agent:
        cmd += ["--agent", agent]
    detach: dict = {}
    if sys.platform == "win32":
        detach["creationflags"] = (subprocess.CREATE_NEW_PROCESS_GROUP
                                   | subprocess.DETACHED_PROCESS)
    else:
        detach["start_new_session"] = True
    log_file.parent.mkdir(parents=True, exist_ok=True)
    with open(log_file.with_suffix(".proc.log"), "a", encoding="utf-8") as lf:
        proc = subprocess.Popen(cmd, cwd=str(PROJECT_ROOT), stdout=lf, stderr=lf, **detach)
    return proc.pid


