MAX_ROUND_MINUTES = int(os.getenv("PIPELINE_MAX_ROUND_MINUTES", "45"))
MAX_ATTEMPTS = int(os.getenv("PIPELINE_MAX_ATTEMPTS", "2"))
LLM_TIMEOUT = int(os.getenv("PIPELINE_LLM_TIMEOUT", "900"))

TERMINAL_STATES = {"done", "error", "cancelled"}

# --------------------------------------------------------------- configurazione
