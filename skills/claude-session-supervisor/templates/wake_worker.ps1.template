# wake_worker.ps1 - Entrypoint manuale per worker Claude autonomo.
# Lancia `claude -p` con worker-settings.json. Il supervisor (hook PreToolUse)
# governa i tool call.
#
# Skill di provenienza: claude-session-supervisor (vibecoding 3.3.0+).
#
# Note implementative (NON modificare salvo bug):
# - Usa System.Diagnostics.Process invece di Start-Process perche'
#   Start-Process -ArgumentList ha bug noto col quoting di argomenti contenenti spazi
# - Mission passato via stdin (no -p <arg>): evita giant cmdline + quoting issues
# - Settings via path relativo (project root = cwd): no spazi nel path passato
# - UTF-8 forzato su stdin/stdout/stderr per accenti/caratteri non-ASCII
# - Process.Close() + retry su Add-Content: dopo WaitForExit gli handle Windows
#   possono persistere brevemente (antivirus, indexer)
#
# CUSTOMIZE:
# - $TIMEOUT_SEC: timeout hard del worker (default 600 = 10 min)

#Requires -Version 5.1
param(
    [string]$TaskFile = ""
)

$ErrorActionPreference = "Stop"
$TIMEOUT_SEC = 600

# === Paths ===
$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path
$ProjectRoot = (Resolve-Path (Join-Path $ScriptDir "..\..")).Path
$OpsDir = Join-Path $ProjectRoot "docs\ops"
$LockFile = Join-Path $OpsDir ".worker.lock"
$CounterFile = Join-Path $OpsDir ".run_counter.tmp"
$TaskQueue = Join-Path $OpsDir "TASK_QUEUE.md"
$LastRun = Join-Path $OpsDir "LAST_RUN.md"
$AuditFile = Join-Path $OpsDir "AUDIT.md"
$WorkerSettingsRel = "scripts/ops/worker-settings.json"

Set-Location $ProjectRoot

# Override mission con -TaskFile
if ($TaskFile) {
    $candidate = if (Test-Path $TaskFile) { $TaskFile } else { Join-Path $ProjectRoot $TaskFile }
    if (-not (Test-Path $candidate)) { throw "TaskFile non trovato: $TaskFile" }
    $TaskQueue = (Resolve-Path $candidate).Path
    Write-Host "OVERRIDE mission: $TaskQueue" -ForegroundColor Magenta
}

# === Lock ===
if (Test-Path $LockFile) {
    $existingPid = (Get-Content $LockFile -ErrorAction SilentlyContinue) -as [int]
    if ($existingPid -and (Get-Process -Id $existingPid -ErrorAction SilentlyContinue)) {
        Write-Host "Worker gia' in esecuzione (PID $existingPid). Abort." -ForegroundColor Yellow
        exit 1
    }
    Write-Host "Lock stale. Pulizia." -ForegroundColor Yellow
    Remove-Item $LockFile -Force
}
$PID | Out-File $LockFile -Encoding ASCII

# === Reset counter ===
if (Test-Path $CounterFile) { Remove-Item $CounterFile -Force }

# === Mission ===
$mission = Get-Content $TaskQueue -Raw -Encoding UTF8

$startTime = Get-Date
Write-Host "===== WORKER START $($startTime.ToString('o')) =====" -ForegroundColor Cyan
Write-Host "ProjectRoot:    $ProjectRoot"
Write-Host "Settings (rel): $WorkerSettingsRel"
Write-Host "TaskQueue:      $TaskQueue"
Write-Host ""

$exitCode = -99
$status = "UNKNOWN"
$stdout = ""
$stderr = ""

try {
    $pinfo = New-Object System.Diagnostics.ProcessStartInfo
    $pinfo.FileName = "claude"
    $pinfo.Arguments = "-p --settings $WorkerSettingsRel --output-format text"
    $pinfo.WorkingDirectory = $ProjectRoot
    $pinfo.RedirectStandardInput = $true
    $pinfo.RedirectStandardOutput = $true
    $pinfo.RedirectStandardError = $true
    $pinfo.UseShellExecute = $false
    $pinfo.CreateNoWindow = $true
    $pinfo.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $pinfo.StandardErrorEncoding = [System.Text.Encoding]::UTF8

    $proc = New-Object System.Diagnostics.Process
    $proc.StartInfo = $pinfo
    [void]$proc.Start()

    $stdoutTask = $proc.StandardOutput.ReadToEndAsync()
    $stderrTask = $proc.StandardError.ReadToEndAsync()

    $missionBytes = [System.Text.Encoding]::UTF8.GetBytes($mission)
    $proc.StandardInput.BaseStream.Write($missionBytes, 0, $missionBytes.Length)
    $proc.StandardInput.BaseStream.Flush()
    $proc.StandardInput.Close()

    if (-not $proc.WaitForExit($TIMEOUT_SEC * 1000)) {
        Write-Host "Worker timeout (>${TIMEOUT_SEC}s). Kill." -ForegroundColor Red
        try { $proc.Kill() } catch { }
        $exitCode = -1
        $status = "TIMEOUT"
    } else {
        $exitCode = $proc.ExitCode
        $status = if ($exitCode -eq 0) { "OK" } else { "ERROR exit=$exitCode" }
    }

    $stdout = $stdoutTask.Result
    $stderr = $stderrTask.Result

    try { $proc.Close() } catch { }
    try { $proc.Dispose() } catch { }
} catch {
    $exitCode = -2
    $status = "EXCEPTION: $($_.Exception.Message)"
    $stderr = $_.Exception.ToString()
}

$endTime = Get-Date
$duration = [math]::Round(($endTime - $startTime).TotalSeconds, 1)
$toolCalls = if (Test-Path $CounterFile) { (Get-Content $CounterFile -Raw).Trim() } else { "0" }

if (Test-Path $LockFile) { Remove-Item $LockFile -Force }

$stderrTail = if ($stderr) { ($stderr -split "`n" | Select-Object -Last 30) -join "`n" } else { "(vuoto)" }
$stdoutTail = if ($stdout) { ($stdout -split "`n" | Select-Object -Last 20) -join "`n" } else { "(vuoto)" }

$footer = @"

---

## Run metadata (wake_worker.ps1)

- inizio: $($startTime.ToString('o'))
- fine: $($endTime.ToString('o'))
- durata: $duration s
- esito: $status
- tool call totali (counter supervisor): $toolCalls

### stderr (ultime 30 righe)

``````
$stderrTail
``````

### stdout (ultime 20 righe)

``````
$stdoutTail
``````
"@

# Retry: handle del worker possono persistere brevemente dopo WaitForExit
$appended = $false
for ($i = 1; $i -le 10; $i++) {
    try {
        Add-Content -Path $LastRun -Value $footer -Encoding UTF8 -ErrorAction Stop
        $appended = $true
        break
    } catch {
        Start-Sleep -Milliseconds (200 * $i)
    }
}
if (-not $appended) {
    Write-Host "WARN: impossibile appendere footer a LAST_RUN.md (file lockato)" -ForegroundColor Yellow
}

Write-Host ""
Write-Host "===== WORKER END $($endTime.ToString('o')) =====" -ForegroundColor Cyan
Write-Host "Esito:      $status"
Write-Host "Durata:     ${duration}s"
Write-Host "Tool calls: $toolCalls"
Write-Host "LAST_RUN:   $LastRun"
Write-Host "AUDIT:      $AuditFile"

exit $exitCode
