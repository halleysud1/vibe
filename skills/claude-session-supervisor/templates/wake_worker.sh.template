#!/usr/bin/env bash
# wake_worker.sh - Entrypoint manuale per worker Claude autonomo (Unix/macOS).
# Lancia `claude -p` con worker-settings.json. Il supervisor (hook PreToolUse)
# governa i tool call.
#
# Skill di provenienza: claude-session-supervisor (vibecoding 3.3.0+).
#
# Dipendenze: bash 4+, claude CLI nel PATH, python3, timeout (coreutils).
# macOS: brew install coreutils -> usa `gtimeout` o aggiunge `timeout` al PATH.
#
# CUSTOMIZE:
# - TIMEOUT_SEC: timeout hard del worker (default 600 = 10 min)

set -euo pipefail

# === Args ===
TASK_FILE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --task-file|-t) TASK_FILE="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: $0 [--task-file <path>]"
            echo "  --task-file <path>   File mission alternativo (default: docs/ops/TASK_QUEUE.md)"
            exit 0
            ;;
        *) echo "Unknown arg: $1" >&2; exit 1 ;;
    esac
done

TIMEOUT_SEC=600

# === Paths ===
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$( cd "${SCRIPT_DIR}/../.." && pwd )"
OPS_DIR="${PROJECT_ROOT}/docs/ops"
LOCK_FILE="${OPS_DIR}/.worker.lock"
COUNTER_FILE="${OPS_DIR}/.run_counter.tmp"
TASK_QUEUE_DEFAULT="${OPS_DIR}/TASK_QUEUE.md"
LAST_RUN="${OPS_DIR}/LAST_RUN.md"
AUDIT_FILE="${OPS_DIR}/AUDIT.md"
WORKER_SETTINGS_REL="scripts/ops/worker-settings.json"

cd "${PROJECT_ROOT}"

# Override mission con --task-file
TASK_QUEUE="${TASK_QUEUE_DEFAULT}"
if [[ -n "${TASK_FILE}" ]]; then
    if [[ -f "${TASK_FILE}" ]]; then
        TASK_QUEUE="$( cd "$( dirname "${TASK_FILE}" )" && pwd )/$( basename "${TASK_FILE}" )"
    elif [[ -f "${PROJECT_ROOT}/${TASK_FILE}" ]]; then
        TASK_QUEUE="${PROJECT_ROOT}/${TASK_FILE}"
    else
        echo "TaskFile non trovato: ${TASK_FILE}" >&2
        exit 1
    fi
    echo "OVERRIDE mission: ${TASK_QUEUE}"
fi

# === Lock ===
if [[ -f "${LOCK_FILE}" ]]; then
    existing_pid="$(cat "${LOCK_FILE}" 2>/dev/null || true)"
    if [[ -n "${existing_pid}" ]] && kill -0 "${existing_pid}" 2>/dev/null; then
        echo "Worker gia' in esecuzione (PID ${existing_pid}). Abort." >&2
        exit 1
    fi
    echo "Lock stale. Pulizia."
    rm -f "${LOCK_FILE}"
fi
echo $$ > "${LOCK_FILE}"
trap 'rm -f "${LOCK_FILE}"' EXIT

# === Reset counter ===
rm -f "${COUNTER_FILE}"

# === Mission ===
if [[ ! -f "${TASK_QUEUE}" ]]; then
    echo "TASK_QUEUE mancante: ${TASK_QUEUE}" >&2
    exit 1
fi

START_ISO="$(date --iso-8601=seconds 2>/dev/null || date "+%Y-%m-%dT%H:%M:%S%z")"
START_EPOCH="$(date +%s)"

echo "===== WORKER START ${START_ISO} ====="
echo "ProjectRoot:    ${PROJECT_ROOT}"
echo "Settings (rel): ${WORKER_SETTINGS_REL}"
echo "TaskQueue:      ${TASK_QUEUE}"
echo ""

# Detect timeout cmd (gtimeout su macOS con coreutils)
TIMEOUT_CMD=""
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD="timeout"
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD="gtimeout"
fi

STDOUT_FILE="$(mktemp -t worker_out.XXXXXX)"
STDERR_FILE="$(mktemp -t worker_err.XXXXXX)"
EXIT_CODE=0
STATUS="OK"

if [[ -n "${TIMEOUT_CMD}" ]]; then
    set +e
    "${TIMEOUT_CMD}" "${TIMEOUT_SEC}" bash -c \
        "cat \"${TASK_QUEUE}\" | claude -p --settings ${WORKER_SETTINGS_REL} --output-format text" \
        >"${STDOUT_FILE}" 2>"${STDERR_FILE}"
    EXIT_CODE=$?
    set -e
    if [[ ${EXIT_CODE} -eq 124 ]]; then
        STATUS="TIMEOUT"
    elif [[ ${EXIT_CODE} -ne 0 ]]; then
        STATUS="ERROR exit=${EXIT_CODE}"
    fi
else
    echo "WARN: 'timeout' non disponibile, niente kill automatico" >&2
    set +e
    cat "${TASK_QUEUE}" | claude -p --settings "${WORKER_SETTINGS_REL}" --output-format text \
        >"${STDOUT_FILE}" 2>"${STDERR_FILE}"
    EXIT_CODE=$?
    set -e
    [[ ${EXIT_CODE} -ne 0 ]] && STATUS="ERROR exit=${EXIT_CODE}"
fi

END_ISO="$(date --iso-8601=seconds 2>/dev/null || date "+%Y-%m-%dT%H:%M:%S%z")"
END_EPOCH="$(date +%s)"
DURATION=$(( END_EPOCH - START_EPOCH ))

TOOL_CALLS="0"
if [[ -f "${COUNTER_FILE}" ]]; then
    TOOL_CALLS="$(tr -d '[:space:]' < "${COUNTER_FILE}")"
fi

STDERR_TAIL="$(tail -n 30 "${STDERR_FILE}" 2>/dev/null || echo '')"
STDOUT_TAIL="$(tail -n 20 "${STDOUT_FILE}" 2>/dev/null || echo '')"

cat >>"${LAST_RUN}" <<EOF

---

## Run metadata (wake_worker.sh)

- inizio: ${START_ISO}
- fine: ${END_ISO}
- durata: ${DURATION} s
- esito: ${STATUS}
- tool call totali (counter supervisor): ${TOOL_CALLS}

### stderr (ultime 30 righe)

\`\`\`
${STDERR_TAIL:-(vuoto)}
\`\`\`

### stdout (ultime 20 righe)

\`\`\`
${STDOUT_TAIL:-(vuoto)}
\`\`\`
EOF

rm -f "${STDOUT_FILE}" "${STDERR_FILE}"

echo ""
echo "===== WORKER END ${END_ISO} ====="
echo "Esito:      ${STATUS}"
echo "Durata:     ${DURATION}s"
echo "Tool calls: ${TOOL_CALLS}"
echo "LAST_RUN:   ${LAST_RUN}"
echo "AUDIT:      ${AUDIT_FILE}"

exit "${EXIT_CODE}"
