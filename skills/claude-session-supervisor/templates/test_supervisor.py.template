"""Test minimi del supervisor (allowlist / denylist / kill-switch).

Nessuna invocazione `claude -p` reale: testa solo la logica statica.
Da posizionare in `tests/ops/test_supervisor.py` del progetto adottante.

Skill di provenienza: claude-session-supervisor (vibecoding 3.3.0+).

Eseguibile con:
    pytest tests/ops/test_supervisor.py -v
"""
import json
import subprocess
import sys
from pathlib import Path

import pytest

# Adatta se il layout del progetto e' diverso
PROJECT_ROOT = Path(__file__).resolve().parents[2]
SUPERVISOR = PROJECT_ROOT / "scripts" / "ops" / "supervisor.py"


def _run_supervisor(payload: dict) -> tuple[int, str]:
    """Lancia supervisor.py passando payload via stdin. Ritorna (exit_code, stderr)."""
    p = subprocess.run(
        [sys.executable, str(SUPERVISOR)],
        input=json.dumps(payload),
        capture_output=True, text=True, timeout=15,
        cwd=str(PROJECT_ROOT),
    )
    return p.returncode, p.stderr


def test_read_data_estrazioni_is_allowlisted():
    code, _ = _run_supervisor({
        "tool_name": "Read",
        "tool_input": {"file_path": "data/estrazioni/test.json"},
    })
    assert code == 0


def test_write_outside_docs_ops_is_denied():
    code, err = _run_supervisor({
        "tool_name": "Write",
        "tool_input": {"file_path": "src/policy.py", "content": "x"},
    })
    assert code == 2
    assert "docs/ops" in err.lower() or "scrittura" in err.lower()


def test_mcp_tool_is_denied_by_default():
    code, err = _run_supervisor({
        "tool_name": "mcp__someserver_search",
        "tool_input": {"query": "x"},
    })
    assert code == 2
    assert "mcp" in err.lower()


def test_bash_destructive_is_denied():
    code, err = _run_supervisor({
        "tool_name": "Bash",
        "tool_input": {"command": "rm -rf data/"},
    })
    assert code == 2
    assert "distruttivo" in err.lower() or "rm" in err.lower()


def test_read_env_is_denied():
    code, err = _run_supervisor({
        "tool_name": "Read",
        "tool_input": {"file_path": ".env"},
    })
    assert code == 2
    assert ".env" in err.lower()


def test_bash_readonly_is_allowlisted():
    code, _ = _run_supervisor({
        "tool_name": "Bash",
        "tool_input": {"command": "ls data/estrazioni"},
    })
    assert code == 0


# Test del kill-switch: scriviamo manualmente un counter > limite e verifichiamo DENY.
# (Test "white-box": tocca un file di runtime. Skip-pabile se non desiderato.)
def test_kill_switch_blocks_at_limit(tmp_path, monkeypatch):
    counter_file = PROJECT_ROOT / "docs" / "ops" / ".run_counter.tmp"
    counter_file.write_text("999")  # ben oltre 200
    try:
        code, err = _run_supervisor({
            "tool_name": "Read",
            "tool_input": {"file_path": "data/estrazioni/x.json"},
        })
        assert code == 2
        assert "kill-switch" in err.lower()
    finally:
        counter_file.unlink(missing_ok=True)
